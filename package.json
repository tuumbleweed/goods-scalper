        "@types/jest": "^26.0.14",
        "@types/libxmljs": "^0.18.6",
        "@types/n-readlines": "^1.0.1",
        "@types/node": "^14.10.2",
        "@types/node-fetch": "^2.5.7",
        "@types/pg": "^7.14.5",
        "@types/pg-copy-streams": "^1.2.1",
        "@types/redis": "^2.8.28",
        "@types/winston": "^2.4.4",
        "@typescript-eslint/eslint-plugin": "^4.1.1",
        "@typescript-eslint/parser": "^4.1.1",
        "dts-gen": "^0.6.0",
        "eslint": "^7.9.0",
        "jest": "^26.4.2",
        "ts-jest": "^26.3.0",
        "ts-node": "^9.0.0"
