{
    "name": "ts-node-starter",
    "version": "0.0.1",
    "description": "Node.js typescript starter template",
    "repository": {
        "type": "git",
        "url": "https://github.com/vt156/ts-node-starter"
    },
    "author": "vt156",
    "license": "ISC",
    "scripts": {
        "build": "tsc",
        "watch-ts": "tsc -w",
        "lint": "tsc --noEmit && eslint '**/*.{js,ts}' --quiet --fix",
