        "api": "node dist/index.js api",
        "scalp-all": "node dist/index.js scalp-all",
        "example1": "nodemon dist/index.js example",
        "generate-types": "dts-gen -m"
    },
    "dependencies": {
        "abort-controller": "^3.0.0",
        "body-parser": "^1.19.0",
        "commander": "^6.1.0",
        "compression": "^1.7.4",
        "dotenv": "^8.2.0",
        "express": "^4.17.1",
        "libxmljs": "^0.19.7",
        "n-readlines": "^1.0.0",
        "node-fetch": "^2.6.1",
        "nodemon": "^2.0.6",
        "pg": "^8.4.2",
        "pg-copy-streams": "^5.1.1",
        "playwright": "^1.10.0",
        "process-list": "^2.0.0",
        "proxy-agent": "^4.0.0",
        "redis": "^3.1.2",
        "rollbar": "^2.19.3",
        "typescript": "^4.0.2",
        "uuid4": "^2.0.2",
        "winston": "^3.3.3"
